          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1ja0st2125859o1h9brqw0ccx2y6].[usr:Calculation_2548962542141457:qk]' value='p0.0%' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.1ja0st2125859o1h9brqw0ccx2y6].[usr:Calculation_2548962542141457:qk]' palette='red_10_0' type='interpolated' />
          </style-rule>
