        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Customer Status] = &quot;Churned&quot; THEN [Customer ID] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Customer ID])' />
