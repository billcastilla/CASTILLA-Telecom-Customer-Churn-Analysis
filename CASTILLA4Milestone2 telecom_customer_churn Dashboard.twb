          <formatted-text>
            <run>Customer Churn Rate By Age Group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='telecom_customer_churn (1)' name='federated.1ja0st2125859o1h9brqw0ccx2y6' />
          </datasources>
          <datasource-dependencies datasource='federated.1ja0st2125859o1h9brqw0ccx2y6'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column caption='Age Group' datatype='string' name='[Calculation_2548962178682888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Age] &gt;= 10 AND [Age] &lt; 20 THEN &quot;10–19&quot;&#13;&#10;ELSEIF [Age] &gt;= 20 AND [Age] &lt; 30 THEN &quot;20–29&quot;&#13;&#10;ELSEIF [Age] &gt;= 30 AND [Age] &lt; 40 THEN &quot;30–39&quot;&#13;&#10;ELSEIF [Age] &gt;= 40 AND [Age] &lt; 50 THEN &quot;40–49&quot;&#13;&#10;ELSEIF [Age] &gt;= 50 AND [Age] &lt; 60 THEN &quot;50–59&quot;&#13;&#10;ELSEIF [Age] &gt;= 60 AND [Age] &lt; 70 THEN &quot;60–69&quot;&#13;&#10;ELSEIF [Age] &gt;= 70 AND [Age] &lt; 80 THEN &quot;70–79&quot;&#13;&#10;ELSE &quot;80+&quot;&#13;&#10;END' />
            </column>
            <column caption='Churn Rate Percentage' datatype='real' default-format='p0.0%' name='[Calculation_2548962542141457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [Customer Status] = &quot;Churned&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNT([Customer ID])' />
            </column>
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Customer Status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2548962178682888]' derivation='None' name='[none:Calculation_2548962178682888:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer Status]' derivation='None' name='[none:Customer Status:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2548962542141457]' derivation='User' name='[usr:Calculation_2548962542141457:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ja0st2125859o1h9brqw0ccx2y6].[none:Customer Status:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Customer Status:nk]' member='&quot;Churned&quot;' />
              <groupfilter function='member' level='[none:Customer Status:nk]' member='&quot;Stayed&quot;' />
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1ja0st2125859o1h9brqw0ccx2y6].[none:Calculation_2548962178682888:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1ja0st2125859o1h9brqw0ccx2y6].[usr:Calculation_2548962542141457:qk]' shelf='rows' />
          </shelf-sorts>
