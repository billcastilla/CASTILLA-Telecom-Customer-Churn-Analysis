      <column caption='Age Group' datatype='string' name='[Calculation_2548962178682888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &gt;= 10 AND [Age] &lt; 20 THEN &quot;10–19&quot;&#13;&#10;ELSEIF [Age] &gt;= 20 AND [Age] &lt; 30 THEN &quot;20–29&quot;&#13;&#10;ELSEIF [Age] &gt;= 30 AND [Age] &lt; 40 THEN &quot;30–39&quot;&#13;&#10;ELSEIF [Age] &gt;= 40 AND [Age] &lt; 50 THEN &quot;40–49&quot;&#13;&#10;ELSEIF [Age] &gt;= 50 AND [Age] &lt; 60 THEN &quot;50–59&quot;&#13;&#10;ELSEIF [Age] &gt;= 60 AND [Age] &lt; 70 THEN &quot;60–69&quot;&#13;&#10;ELSEIF [Age] &gt;= 70 AND [Age] &lt; 80 THEN &quot;70–79&quot;&#13;&#10;ELSE &quot;80+&quot;&#13;&#10;END' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_2548962457595917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Customer Status] = &quot;Churned&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNT([Customer ID])' />
